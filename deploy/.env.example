# 本地验证只监听本机；部署到云服务器时按 README 改为正式域名和 HTTPS。
TARA_ENVIRONMENT=development
TARA_SITE_ADDRESS=http://localhost
TARA_PUBLIC_ORIGIN=http://localhost:8080
TARA_BIND_ADDRESS=127.0.0.1
TARA_HTTP_PORT=8080
TARA_HTTPS_PORT=8443

# 数据目录相对于项目根目录；Windows 绝对路径请使用 C:/... 写法。
TARA_SOURCE_DATA_DIR=./Tara_4_Core_Datasets

POSTGRES_DB=tara_agent
POSTGRES_USER=tara_agent
# 自己生成密码。含 $、# 或空格时，用单引号包住完整值。
POSTGRES_PASSWORD='replace-with-a-long-random-password'
DEEPSEEK_API_KEY='replace-with-your-api-key'
